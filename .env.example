# Copy to .env and adjust. Never commit .env.
# Compose reads this file automatically from the repo root.

# --- MongoDB ---
# Change if a MongoDB installed on the host already uses 27017.
MONGO_PORT=27017
# A replica set is required for transactions and change streams.
# directConnection keeps the driver from trying to resolve other members.
DATABASE_URL=mongodb://mongo:27017/poker?replicaSet=rs0&directConnection=true

# --- Server ---
SERVER_PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=*

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars

# --- Tooling ---
MONGO_EXPRESS_PORT=8081

# --- Client ---
# On a physical phone this must be your machine's LAN or Tailscale IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Public origin ---
PUBLIC_URL=http://localhost:4000
