# Copy to .env and adjust. Never commit .env.
# Compose reads this file automatically from the repo root.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Server ---
SERVER_PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=*

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars

# --- Tooling ---
ADMINER_PORT=8080

# --- Media library (streaming topic only) ---
# Absolute path on the host that gets mounted read-only at /media
MEDIA_PATH=./infra/media

# --- Clients ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# On a physical phone this must be your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000
