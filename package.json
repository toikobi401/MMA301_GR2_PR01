{
  "name": "mma301-gr2-pr01",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run start --workspace @app/client",
    "android": "npm run android --workspace @app/client",
    "ios": "npm run ios --workspace @app/client",
    "web": "npm run web --workspace @app/client",
    "build:web": "npm run build:web --workspace @app/client",
    "server:dev": "npm run dev --workspace @app/server",
    "seed:bots": "npm run seed:bots --workspace @app/server",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f infra/docker-compose.yml down -v",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
